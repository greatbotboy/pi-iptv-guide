[Unit]
Description=Pi IPTV Channel Guide (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/iptv-guide
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/iptv-guide/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --app-dir %h/iptv-guide/app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
